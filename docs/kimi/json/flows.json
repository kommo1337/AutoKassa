{
  "lastUpdated": "2026-07-07T02:14:25+03:00",
  "flows": [
    {
      "name": "Запуск приложения",
      "trigger": "Пользователь запускает AutoKassa.exe",
      "servicesInvolved": [
        "SettingsService",
        "NavigationService",
        "LockService"
      ],
      "viewModelsInvolved": [
        "InitialSetupViewModel",
        "MainWindowViewModel",
        "DashboardViewModel"
      ],
      "steps": [
        {
          "order": 1,
          "actor": "UI",
          "action": "Запуск WPF-приложения",
          "file": "App.xaml.cs",
          "method": "OnStartup",
          "notes": "Точка входа приложения. Сначала настраивается Serilog, затем регистрируются глобальные обработчики исключений."
        },
        {
          "order": 2,
          "actor": "Service",
          "action": "Конфигурация Dependency Injection",
          "file": "App.xaml.cs",
          "method": "ConfigureServices",
          "notes": "Регистрируются DbContext, сервисы, фабрики, ViewModels и MainWindow."
        },
        {
          "order": 3,
          "actor": "Service",
          "action": "Асинхронная инициализация базы данных и настроек",
          "file": "App.xaml.cs",
          "method": "InitializeAsync",
          "notes": "Выполняется синхронно через Task.Run(...).GetAwaiter().GetResult(): SettingsService.MigrateAsync + разогрев кеша настроек."
        },
        {
          "order": 4,
          "actor": "Service",
          "action": "Применение pending-миграций и включение WAL",
          "file": "Services/SettingsService.cs",
          "method": "MigrateAsync",
          "notes": "Автоматически применяет EF Core миграции и выполняет PRAGMA journal_mode=WAL."
        },
        {
          "order": 5,
          "actor": "Service",
          "action": "Проверка наличия пароля",
          "file": "Services/SettingsService.cs",
          "method": "IsPasswordSet",
          "notes": "Если PasswordHash пустой — первый запуск, показывается InitialSetupView."
        },
        {
          "order": 6,
          "actor": "ViewModel",
          "action": "Настройка пароля и секретного вопроса",
          "file": "ViewModels/InitialSetupViewModel.cs",
          "method": "ContinueAsync",
          "notes": "Пользователь задаёт пароль, выбирает/вводит секретный вопрос и ответ. Хешируются через PasswordService."
        },
        {
          "order": 7,
          "actor": "ViewModel",
          "action": "Сохранение пароля в настройках",
          "file": "Services/SettingsService.cs",
          "method": "SetPasswordAsync",
          "notes": "Сохраняет PasswordHash, SecurityQuestionId, SecurityAnswerHash, CustomSecurityQuestion."
        },
        {
          "order": 8,
          "actor": "UI",
          "action": "Открытие главного окна",
          "file": "App.xaml.cs",
          "method": "OnStartup",
          "notes": "Создаётся MainWindow через DI и вызывается Show()."
        },
        {
          "order": 9,
          "actor": "ViewModel",
          "action": "Инициализация главного окна",
          "file": "ViewModels/MainWindowViewModel.cs",
          "method": ".ctor",
          "notes": "Загружает настройки, подписывается на навигацию, запускает автоблокировку и сразу переходит на Dashboard."
        }
      ]
    },
    {
      "name": "Добавление операции (с дашборда)",
      "trigger": "Пользователь нажимает кнопку «+» на главном экране",
      "servicesInvolved": [
        "DashboardTransactionCoordinator",
        "TransactionEditViewModelFactory",
        "TransactionService",
        "CategoryService",
        "CreditCardService",
        "CounterpartyService",
        "SettingsService",
        "DialogService",
        "ToastNotificationService",
        "DataChangeService"
      ],
      "viewModelsInvolved": [
        "DashboardViewModel",
        "TransactionEditViewModel"
      ],
      "steps": [
        {
          "order": 1,
          "actor": "User",
          "action": "Нажатие кнопки добавления операции",
          "file": "Views/DashboardView.xaml",
          "method": "Command binding",
          "notes": "Кнопка привязана к DashboardViewModel.OpenAddTransactionCommand."
        },
        {
          "order": 2,
          "actor": "ViewModel",
          "action": "Открытие формы добавления",
          "file": "ViewModels/DashboardViewModel.cs",
          "method": "OpenAddTransaction",
          "notes": "Формируются callbacks OnSaved / OnSavedKeepOpen / OnCancelled и вызывается DashboardTransactionCoordinator.OpenAdd."
        },
        {
          "order": 3,
          "actor": "Service",
          "action": "Создание ViewModel операции через фабрику",
          "file": "Services/Transactions/TransactionEditViewModelFactory.cs",
          "method": "CreateForAdd",
          "notes": "Фабрика инжектирует все зависимости и вызывает vm.InitializeForAdd()."
        },
        {
          "order": 4,
          "actor": "ViewModel",
          "action": "Инициализация полей для новой операции",
          "file": "ViewModels/TransactionEditViewModel.cs",
          "method": "InitializeForAdd",
          "notes": "Сбрасываются сумма, описание, тип по умолчанию из SettingsService, тип оплаты Cash."
        },
        {
          "order": 5,
          "actor": "ViewModel",
          "action": "Загрузка справочников",
          "file": "ViewModels/TransactionEditViewModel.cs",
          "method": "LoadCategoriesAsync / LoadCreditCardsAsync / LoadCounterpartiesAsync",
          "notes": "Асинхронно подгружаются категории, активные кредитные карты и контрагенты."
        },
        {
          "order": 6,
          "actor": "User",
          "action": "Выбор категории, типа оплаты, кредитной карты / контрагента, ввод суммы и описания",
          "file": "Views/TransactionEditView.xaml",
          "method": "Data bindings",
          "notes": "При выборе PaymentType.CreditCard показывается селектор карты; при PaymentType.Debt — селектор контрагента."
        },
        {
          "order": 7,
          "actor": "ViewModel",
          "action": "Валидация полей перед сохранением",
          "file": "ViewModels/TransactionEditViewModel.cs",
          "method": "SaveAsync",
          "notes": "Проверяются сумма (>0), категория, кредитная карта (если нужна), контрагент (если долг), длина описания."
        },
        {
          "order": 8,
          "actor": "ViewModel",
          "action": "Вызов сервиса сохранения операции",
          "file": "ViewModels/TransactionEditViewModel.cs",
          "method": "SaveAsync",
          "notes": "Создаётся объект Transaction и вызывается TransactionService.AddAsync."
        },
        {
          "order": 9,
          "actor": "Service",
          "action": "Сохранение операции в БД",
          "file": "Services/TransactionService.cs",
          "method": "AddAsync",
          "notes": "Выполняется в транзакции. Для долговой операции устанавливается DebtStatus.Active; для кредитной карты создаётся CreditCardPurchase."
        },
        {
          "order": 10,
          "actor": "Service",
          "action": "Уведомление об изменении данных",
          "file": "Services/IDataChangeService.cs",
          "method": "NotifyDataChanged",
          "notes": "Вызывается из callback-а OnSaved для инвалидации кэшей других экранов."
        },
        {
          "order": 11,
          "actor": "ViewModel",
          "action": "Оптимистичное обновление UI",
          "file": "ViewModels/DashboardViewModel.cs",
          "method": "ApplyOptimisticAdd",
          "notes": "Операция сразу появляется в списке и сводке до полной перезагрузки."
        },
        {
          "order": 12,
          "actor": "ViewModel",
          "action": "Полная перезагрузка данных дашборда",
          "file": "ViewModels/DashboardViewModel.cs",
          "method": "LoadDataAsync",
          "notes": "Загружает актуальные данные через DashboardService и перерисовывает график."
        }
      ]
    },
    {
      "name": "Добавление операции (из экрана операций)",
      "trigger": "Пользователь нажимает кнопку «Добавить» на экране операций",
      "servicesInvolved": [
        "TransactionEditViewModelFactory",
        "TransactionService",
        "CategoryService",
        "CreditCardService",
        "CounterpartyService",
        "SettingsService",
        "DialogService",
        "ToastNotificationService",
        "DataChangeService"
      ],
      "viewModelsInvolved": [
        "TransactionsViewModel",
        "TransactionEditViewModel"
      ],
      "steps": [
        {
          "order": 1,
          "actor": "User",
          "action": "Нажатие кнопки «Добавить»",
          "file": "Views/TransactionsView.xaml",
          "method": "Command binding",
          "notes": "Кнопка привязана к TransactionsViewModel.AddCommand."
        },
        {
          "order": 2,
          "actor": "ViewModel",
          "action": "Создание редактора операции",
          "file": "ViewModels/TransactionsViewModel.cs",
          "method": "AddTransaction",
          "notes": "Напрямую вызывает TransactionEditViewModelFactory.CreateForAdd() и настраивает callbacks."
        },
        {
          "order": 3,
          "actor": "Service",
          "action": "Фабрика создаёт TransactionEditViewModel",
          "file": "Services/Transactions/TransactionEditViewModelFactory.cs",
          "method": "CreateForAdd",
          "notes": "Аналогично дашборду, но без DashboardTransactionCoordinator."
        },
        {
          "order": 4,
          "actor": "ViewModel",
          "action": "Открытие модального окна",
          "file": "ViewModels/TransactionsViewModel.cs",
          "method": "AddTransaction",
          "notes": "IsModalOpen = true, EditViewModel = vm."
        },
        {
          "order": 5,
          "actor": "User",
          "action": "Заполнение полей операции",
          "file": "Views/TransactionEditView.xaml",
          "method": "Data bindings",
          "notes": "Сумма, категория, тип оплаты, кредитная карта/контрагент, описание."
        },
        {
          "order": 6,
          "actor": "ViewModel",
          "action": "Сохранение операции",
          "file": "ViewModels/TransactionEditViewModel.cs",
          "method": "SaveAsync",
          "notes": "Валидация и вызов TransactionService.AddAsync."
        },
        {
          "order": 7,
          "actor": "Service",
          "action": "Сохранение в БД",
          "file": "Services/TransactionService.cs",
          "method": "AddAsync",
          "notes": "Soft-delete-операции. Для кредитки создаётся CreditCardPurchase, для долга — DebtStatus.Active."
        },
        {
          "order": 8,
          "actor": "ViewModel",
          "action": "Оптимистичное добавление в список",
          "file": "ViewModels/TransactionsViewModel.cs",
          "method": "OptimisticAddTransaction",
          "notes": "Вставляет операцию в начало Transactions и увеличивает TotalCount."
        },
        {
          "order": 9,
          "actor": "ViewModel",
          "action": "Перегруппировка и перезагрузка",
          "file": "ViewModels/TransactionsViewModel.cs",
          "method": "RefreshGroupsAsync / LoadDataAsync",
          "notes": "Обновляет сгруппированный список и итоги, вызывает DataChangeService.NotifyDataChanged."
        }
      ]
    },
    {
      "name": "Погашение кредитной карты",
      "trigger": "Пользователь выбирает кредитную карту и нажимает «Погасить»",
      "servicesInvolved": [
        "CreditCardService",
        "CreditCardOperationHelper",
        "DialogService",
        "ToastNotificationService",
        "DataChangeService"
      ],
      "viewModelsInvolved": [
        "CreditCardsViewModel",
        "CreditCardRepaymentViewModel"
      ],
      "steps": [
        {
          "order": 1,
          "actor": "User",
          "action": "Открытие экрана кредитных карт и выбор карты",
          "file": "Views/CreditCardsView.xaml",
          "method": "SelectionChanged",
          "notes": "CreditCardsViewModel загружает список карт и метрики в OnNavigatedTo / LoadCardsAsync."
        },
        {
          "order": 2,
          "actor": "User",
          "action": "Нажатие кнопки «Погасить»",
          "file": "Views/CreditCardsView.xaml",
          "method": "Command binding",
          "notes": "Команда доступна только если SelectedCardItem.CurrentDebt > 0."
        },
        {
          "order": 3,
          "actor": "ViewModel",
          "action": "Открытие формы погашения",
          "file": "ViewModels/CreditCardsViewModel.cs",
          "method": "OpenRepayCard",
          "notes": "Создаёт CreditCardRepaymentViewModel, настраивает OnSaved/OnCancelled и вызывает InitializeAsync."
        },
        {
          "order": 4,
          "actor": "ViewModel",
          "action": "Инициализация формы",
          "file": "ViewModels/CreditCardRepaymentViewModel.cs",
          "method": "InitializeAsync",
          "notes": "Загружает текущий долг через CreditCardService.GetCurrentDebtAsync, по умолчанию сумма равна долгу."
        },
        {
          "order": 5,
          "actor": "User",
          "action": "Ввод суммы, типа оплаты, даты и описания",
          "file": "Views/CreditCardRepaymentView.xaml",
          "method": "Data bindings",
          "notes": "Сумма ограничена текущим долгом, дата не может быть в будущем."
        },
        {
          "order": 6,
          "actor": "ViewModel",
          "action": "Валидация и вызов сервиса",
          "file": "ViewModels/CreditCardRepaymentViewModel.cs",
          "method": "RepayAsync",
          "notes": "Проверяет сумму и дату, затем вызывает CreditCardService.RepayDebtAsync."
        },
        {
          "order": 7,
          "actor": "Service",
          "action": "Создание операции-погашения",
          "file": "Services/CreditCardService.cs",
          "method": "RepayDebtAsync",
          "notes": "Создаёт Expense-операцию в категории «Погашение кредита» с выбранным типом оплаты."
        },
        {
          "order": 8,
          "actor": "Service",
          "action": "Распределение суммы по покупкам FIFO",
          "file": "Services/CreditCardOperationHelper.cs",
          "method": "DistributeRepaymentAsync",
          "notes": "Погашает самые ранние CreditCardPurchase с ненулевым RemainingDebt, создаёт записи CreditCardPayment."
        },
        {
          "order": 9,
          "actor": "Service",
          "action": "Сохранение изменений",
          "file": "Services/CreditCardService.cs",
          "method": "RepayDebtAsync",
          "notes": "SaveChanges фиксирует операцию и распределение в одной транзакции."
        },
        {
          "order": 10,
          "actor": "ViewModel",
          "action": "Обновление UI",
          "file": "ViewModels/CreditCardsViewModel.cs",
          "method": "OnSaved callback",
          "notes": "Закрывает модалку, перезагружает список карт и покупки, вызывает DataChangeService.NotifyDataChanged."
        }
      ]
    },
    {
      "name": "Работа с долгами (создание и погашение)",
      "trigger": "Пользователь создаёт долговую операцию и позже погашает её",
      "servicesInvolved": [
        "TransactionService",
        "DebtService",
        "DialogService",
        "ToastNotificationService",
        "DataChangeService"
      ],
      "viewModelsInvolved": [
        "TransactionEditViewModel",
        "DebtRepaymentViewModel",
        "CounterpartiesViewModel"
      ],
      "steps": [
        {
          "order": 1,
          "actor": "User",
          "action": "Создание операции с типом оплаты «Долг»",
