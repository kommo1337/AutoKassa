      "servicesInvolved": [
        "SettingsService",
        "SettingsMapper",
        "SettingsValidator",
        "CreditCardSettingsService",
        "BackupCoordinator",
        "AppInfoService",
        "CategoryService",
        "DialogService",
        "ToastNotificationService",
        "DataChangeService"
      ],
      "viewModelsInvolved": [
        "SettingsViewModel",
        "ChangePasswordViewModel"
      ],
      "steps": [
        {
          "order": 1,
          "actor": "User",
          "action": "Открытие настроек",
          "file": "Views/SettingsView.xaml",
          "method": "Navigation",
          "notes": "MainWindowViewModel.NavigateToSettingsCommand."
