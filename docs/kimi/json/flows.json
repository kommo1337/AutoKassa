          "action": "Создание долга в БД",
          "file": "Services/TransactionService.cs",
          "method": "AddAsync",
          "notes": "Для PaymentType.Debt устанавливается DebtStatus.Active. Долг не влияет на фактический баланс."
        },
        {
          "order": 4,
          "actor": "User",
          "action": "Открытие формы погашения долга",
          "file": "Views/CounterpartiesView.xaml / Views/DebtRepaymentView.xaml",
