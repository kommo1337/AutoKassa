          "method": "ConnectYandexCommand",
          "description": "Старт OAuth: PKCE-пара и открытие системного браузера."
        },
        {
          "order": 2,
          "actor": "User",
          "action": "Разрешение доступа и ввод одноразового кода",
          "file": "Views/SettingsView.xaml",
          "method": "",
          "description": "Пользователь вставляет код, показанный браузером после разрешения доступа."
