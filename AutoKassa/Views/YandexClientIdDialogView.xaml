<UserControl x:Class="AutoKassa.Views.YandexClientIdDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="24" Width="392">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0"
                   Text="Подключение Яндекс Диска"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

        <!-- Пояснение -->
        <TextBlock Grid.Row="1"
                   Text="Введите ClientId приложения из кабинета разработчика Яндекса (oauth.yandex.ru). Значение сохранится на этом компьютере."
                   FontSize="12"
                   Foreground="{StaticResource MutedTextBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16"/>

        <!-- Поле ввода -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="ClientId приложения" Margin="0,0,0,6" FontSize="13"/>
            <TextBox Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}"
                     Padding="12,10"
                     FontSize="14"/>
            <TextBlock Text="{Binding ClientIdError}"
                       Foreground="{StaticResource ErrorBrush}"
                       FontSize="12"
                       Margin="0,4,0,0"
                       Visibility="{Binding ClientIdError, Converter={StaticResource StringToVisibilityConverter}}"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="Отмена"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource ActionButtonStyle}"
                    MinWidth="100"
                    Margin="0,0,12,0"/>
            <Button Content="Сохранить"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource ActionButtonStyle}"
                    Background="#22c55e"
                    Foreground="White"
                    MinWidth="100"/>
        </StackPanel>
    </Grid>
</UserControl>
